{
  "name": "claude-usage-widget",
  "version": "1.2.2",
  "description": "Floating always-on-top widget showing Claude Code subscription usage (5-hour and weekly)",
  "main": "src/main/main.js",
  "author": "Ali Abdian",
  "license": "MIT",
  "homepage": "https://github.com/abdian/widget-usageClaude",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdian/widget-usageClaude.git"
  },
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "poster": "electron scripts/make-poster.js",
    "dist": "npm run icons && electron-builder --win --publish never",
    "dist:mac": "npm run icons && electron-builder --mac --publish never",
    "pack": "npm run icons && electron-builder --dir --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.4"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.esanj.claude-usage-widget",
    "productName": "Claude Usage",
    "publish": [
      {
        "provider": "github",
        "owner": "abdian",
        "repo": "widget-usageClaude"
      }
    ],
    "files": [
      "src/**/*",
      "build/icon.*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/koffi/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Usage",
      "artifactName": "Claude-Usage-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "LSUIElement": 1
      },
      "artifactName": "Claude-Usage-${version}-${arch}.${ext}"
    }
  }
}
